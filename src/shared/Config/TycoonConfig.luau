--!strict
export type DropperDef = {
	id: string,
	name: string,
	cost: number,
	currency: "Cash" | "Gems",
	dropInterval: number,
	crystalValue: number,
	gemValue: number?,
	crystalColor: Color3,
	crystalMaterial: Enum.Material,
	prerequisite: string?,
	category: "Dropper",
}

export type UpgraderDef = {
	id: string,
	name: string,
	cost: number,
	currency: "Cash" | "Gems",
	multiplier: number,
	laserColor: Color3,
	prerequisite: string?,
	category: "Upgrader",
}

export type StructureDef = {
	id: string,
	name: string,
	cost: number,
	currency: "Cash" | "Gems",
	prerequisite: string?,
	category: "Structure",
}

export type ItemDef = DropperDef | UpgraderDef | StructureDef

